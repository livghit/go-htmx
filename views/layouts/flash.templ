package layouts

import "github.com/livghit/go-htmx/flash"

templ FlashList(flashes []flash.Flash) {
	for _, f := range flashes {
		@flashItem(f)
	}
}

templ flashItem(f flash.Flash) {
	<div
		x-data="{ show: true }"
		x-show="show"
		x-transition
		class={ "rounded-lg p-4 shadow-lg text-sm font-medium flex items-start justify-between gap-2", flashClass(f.Type) }
	>
		<span>{ f.Message }</span>
		<button @click="show = false" class="ml-2 text-current opacity-60 hover:opacity-100 flex-shrink-0">&times;</button>
	</div>
}

func flashClass(t flash.Type) string {
	switch t {
	case flash.TypeSuccess:
		return "bg-green-50 text-green-800 border border-green-200"
	case flash.TypeError:
		return "bg-red-50 text-red-800 border border-red-200"
	case flash.TypeWarning:
		return "bg-yellow-50 text-yellow-800 border border-yellow-200"
	default:
		return "bg-blue-50 text-blue-800 border border-blue-200"
	}
}

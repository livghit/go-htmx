package pages

import (
	"github.com/livghit/go-htmx/flash"
	"github.com/livghit/go-htmx/validation"
	"github.com/livghit/go-htmx/views/layouts"
)

templ RegisterPage(flashes []flash.Flash, errs validation.Errors) {
	@layouts.Base("Create account", flashes) {
		<div class="max-w-md mx-auto mt-8">
			<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
				<h1 class="text-2xl font-bold text-gray-900 mb-6">Create account</h1>
				<form
					method="POST"
					action="/register"
					class="space-y-4"
					hx-post="/register"
					hx-swap="outerHTML"
					hx-target="closest form"
				>
					<div>
						<label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
						<input
							id="username"
							name="username"
							type="text"
							autocomplete="username"
							class={ "w-full rounded-md border px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", inputClass(errs.Has("username")) }
							placeholder="choose a username"
						/>
						if errs.Has("username") {
							<p class="mt-1 text-xs text-red-600">{ errs.First("username") }</p>
						}
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							class={ "w-full rounded-md border px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", inputClass(errs.Has("email")) }
							placeholder="you@example.com"
						/>
						if errs.Has("email") {
							<p class="mt-1 text-xs text-red-600">{ errs.First("email") }</p>
						}
					</div>
					<div>
						<label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
						<input
							id="password"
							name="password"
							type="password"
							autocomplete="new-password"
							class={ "w-full rounded-md border px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", inputClass(errs.Has("password")) }
							placeholder="min 8 characters"
						/>
						if errs.Has("password") {
							<p class="mt-1 text-xs text-red-600">{ errs.First("password") }</p>
						}
					</div>
					<div>
						<label for="password_confirmation" class="block text-sm font-medium text-gray-700 mb-1">Confirm password</label>
						<input
							id="password_confirmation"
							name="password_confirmation"
							type="password"
							autocomplete="new-password"
							class={ "w-full rounded-md border px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", inputClass(errs.Has("password_confirmation")) }
							placeholder="repeat password"
						/>
						if errs.Has("password_confirmation") {
							<p class="mt-1 text-xs text-red-600">{ errs.First("password_confirmation") }</p>
						}
					</div>
					<button
						type="submit"
						class="w-full py-2.5 px-4 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500"
					>
						Create account
					</button>
					<p class="text-center text-sm text-gray-500">
						Already have an account?
						<a href="/login" class="text-indigo-600 hover:underline">Sign in</a>
					</p>
				</form>
			</div>
		</div>
	}
}
